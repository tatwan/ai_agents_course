%%{init: {"theme": "base", "flowchart": {"curve": "basis", "nodeSpacing": 30, "rankSpacing": 40}, "themeVariables": {"fontFamily": "IBM Plex Mono, monospace", "fontSize": "15px", "primaryColor": "#FFFFFF", "primaryBorderColor": "#0B1220", "primaryTextColor": "#0B1220", "lineColor": "#6B7383", "clusterBkg": "#F4F5F7", "clusterBorder": "#6B7383"}}}%%
%% Lab 02: one question, three shapes. The step that decides is lit: the model in ink, our code in lime.
%% Export: npx -y @mermaid-js/mermaid-cli -i lab02_three_shapes.mmd -o lab02_three_shapes.png -b white -s 2
flowchart LR
    subgraph CHATBOT["chatbot: the model writes the reply"]
        direction TB
        c0[question] --> c1[model<br/>writes text<br/>from memory] --> c2[reply]
    end
    subgraph WORKFLOW["workflow: our code decides every step"]
        direction TB
        w0[question] --> w1[lookup_invoices<br/>our code] --> w2[lookup_rep<br/>our code] --> w3[reply<br/>formatted by<br/>our code]
    end
    subgraph AGENT["agent: the model decides the next step"]
        direction TB
        a0[question] --> a1[model<br/>picks a command]
        a1 -->|LOOKUP_...| a2[our code<br/>runs the lookup]
        a2 -->|Result| a1
        a1 -->|DONE, or<br/>the turn cap| a3[reply]
    end
    CHATBOT ~~~ WORKFLOW ~~~ AGENT
    classDef model fill:#0B1220,color:#FFFFFF,stroke:#0B1220
    classDef code fill:#C9F24D,color:#0B1220,stroke:#0B1220
    class c1,a1 model
    class w1,w2,w3,a2 code
