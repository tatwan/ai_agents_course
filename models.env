# Model settings for every lab. Change a model here, once, and every notebook picks it up.
# This file is committed and holds no secrets. The API key goes in .env (never committed).
# MODEL_DEFAULT is used by almost every cell; MODEL_STRONG only where a task needs more capability.
MODEL_DEFAULT=gpt-6-luna
MODEL_STRONG=gpt-6-luna

# Reasoning effort for gpt-6 models: none, low, medium (the API default), high, xhigh or max.
# Tool calling on Chat Completions works only with none. Leave empty for models without reasoning (gpt-4o-mini).
REASONING_EFFORT=none

# Embeddings (retrieval labs).
EMBEDDING_MODEL=text-embedding-3-small

# List prices, USD per 1 million tokens, for MODEL_DEFAULT. Update them when you change the model.
# gpt-6-luna, checked 30 Oct 2026 at developers.openai.com/api/docs/pricing. Cache writes (30-minute TTL) are billed
# on GPT-5.6 and later models; set PRICE_CACHE_WRITE_PER_MILLION to the input price for models without that charge.
PRICE_INPUT_PER_MILLION=0.10
PRICE_CACHED_INPUT_PER_MILLION=0.01
PRICE_CACHE_WRITE_PER_MILLION=0.125
PRICE_OUTPUT_PER_MILLION=0.50
PRICE_EMBEDDING_PER_MILLION=0.02
