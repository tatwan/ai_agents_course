%% Lab 15, notebook 2: one message from a rep's browser to the support desk agent and back. The rep's session id
%% picks the conversation; the agent's tools read the shop database through a read-only connection.
%% Our code lime, the model ink.
%% Export: npx -y @mermaid-js/mermaid-cli -i lab15_page_flow.mmd -o lab15_page_flow.png -b white -s 2
flowchart TB
    reps["rep A and rep B, each in their own browser tab"]
    respond["the Gradio page calls respond(message, history, request)<br/>session id = request.session_hash (Part E)"]
    runner["the Agents SDK's Runner: the agent loop"]
    session[("SQLiteSession<br/>one conversation<br/>per session id (Part C)")]
    model["model<br/>OpenAI API"]
    tools["three lookups (Part A)<br/>find_customer, get_invoices,<br/>get_support_rep"]
    db[("chinook.db<br/>read-only connection<br/>(Part B)")]
    reps -->|"one message; the reply comes back to that rep"| respond
    respond -->|"the message and the session"| runner
    session <-->|"read before, save after"| runner
    runner <-->|"tool calls"| model
    runner --> tools --> db
    classDef model fill:#0B1220,color:#FFFFFF,stroke:#0B1220
    classDef code fill:#C9F24D,color:#0B1220,stroke:#0B1220
