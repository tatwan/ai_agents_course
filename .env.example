# Copy this file to .env in the repo root and fill in the key.
# Never commit .env. Never print these values from a notebook.

# Required. The instructor-issued OpenAI key for this class.
OPENAI_API_KEY=

# Model pins. Change here, not in notebooks.
# gpt-5.4-nano is the default for almost every cell.
# gpt-5.4-mini is only for tasks that genuinely need more capability.
MODEL_DEFAULT=gpt-5.4-nano
MODEL_STRONG=gpt-5.4-mini

# Embeddings for modules 11, 12, 14. Cheap. Change here, not in notebooks.
EMBEDDING_MODEL=text-embedding-3-small

# Published list prices, USD per 1 million tokens, March 2026.
# Update these if you re-pin models. Used to print a running cost.
PRICE_INPUT_PER_MILLION=0.20
PRICE_CACHED_INPUT_PER_MILLION=0.02
PRICE_OUTPUT_PER_MILLION=1.25

# Optional. Module 16 only. Leave blank until that module.
# AZURE_FOUNDRY_PROJECT_ENDPOINT=
# AZURE_FOUNDRY_API_KEY=
