# Copy this file to .env in the repo root and fill in the key.
# Never commit .env. Never print these values from a notebook.
# Model names and prices are in models.env, not here.

# Required. The OpenAI API key for this class (or your own for self-study).
OPENAI_API_KEY=

# Optional. Only the cells marked optional use it (running an agent on a Gemini model). Every lab runs without it.
# GEMINI_API_KEY=

# Optional, bonus labs only. Every core lab runs without these.
# LangSmith (bonus: trace and evaluate with LangSmith):
# LANGSMITH_API_KEY=
# Pinecone (bonus: retrieval on Pinecone):
# PINECONE_API_KEY=
