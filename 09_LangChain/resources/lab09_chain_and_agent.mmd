%% What it shows: the two shapes of notebook 1. Top: the chain prompt | llm | parser, whose three steps our code
%% fixed; each arrow is labelled with the object one step hands the next. Bottom: the agent create_agent returns,
%% where the path after each model call depends on what the model wrote, and the tools step goes back to the model.
%% Ink: what the model does. Lime: what our own code does (template, parser, tools, the check for tool calls).
%% Export: npx -y @mermaid-js/mermaid-cli -i lab09_chain_and_agent.mmd -o lab09_chain_and_agent.png -b white -s 2
flowchart TB
    subgraph chain["A chain: our code sets the steps"]
        direction LR
        input(["dictionary<br/>name, hobby"]) -->|dict| template["ChatPromptTemplate<br/>fills the gaps"]
        template -->|ChatPromptValue| model1["ChatOpenAI<br/>one model call"]
        model1 -->|AIMessage| parser["StrOutputParser<br/>keeps the text"]
        parser -->|str| output(["birthday message"])
    end
    subgraph agent["An agent: the model picks the next step"]
        direction LR
        messages(["messages"]) --> model2["model<br/>one model call<br/>per turn"]
        model2 --> route{"tool calls<br/>in the reply?"}
        route -->|yes| tools["tools<br/>runs our functions"]
        tools -->|back to the model| model2
        route -->|no| answer(["answer"])
    end
    chain ~~~ agent
    classDef model fill:#0B1220,color:#FFFFFF,stroke:#0B1220
    classDef code fill:#C9F24D,color:#0B1220,stroke:#0B1220
    class model1,model2 model
    class template,parser,route,tools code
