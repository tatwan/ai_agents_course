%%{init: {"theme": "base", "flowchart": {"curve": "basis", "nodeSpacing": 22, "rankSpacing": 40}, "themeVariables": {"fontFamily": "IBM Plex Mono, monospace", "fontSize": "15px", "primaryColor": "#FFFFFF", "primaryBorderColor": "#0B1220", "primaryTextColor": "#0B1220", "lineColor": "#6B7383", "clusterBkg": "#F4F5F7", "clusterBorder": "#6B7383"}}}%%
%% Lab 20: one desk run as a trace. The root span is the whole run; each model call and each tool call is a child span
%% with its start, its duration and what it read and returned. Model calls carry tokens and dollars.
%% Ink: a model call (the model decides). Lime: a tool call (our code runs it). White: the run as a whole.
%% Export: npx -y @mermaid-js/mermaid-cli -i lab20_trace_tree.mmd -o lab20_trace_tree.png -b white -s 2
flowchart LR
    run["desk run<br/>question in, answer out<br/>total seconds and tokens"]
    run --> m1["model call 1<br/>tokens in and out, $, seconds<br/>asks for find_customer"]
    run --> t1["find_customer<br/>arguments and result<br/>milliseconds"]
    run --> m2["model call 2<br/>asks for get_invoices<br/>and get_support_rep"]
    run --> t2["get_invoices"]
    run --> t3["get_support_rep"]
    run --> m3["model call 3<br/>writes the answer"]
    classDef model fill:#0B1220,color:#FFFFFF,stroke:#0B1220
    classDef code fill:#C9F24D,color:#0B1220,stroke:#0B1220
    class m1,m2,m3 model
    class t1,t2,t3 code
