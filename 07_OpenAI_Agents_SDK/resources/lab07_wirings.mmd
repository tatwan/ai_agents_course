%%{init: {"theme": "base", "flowchart": {"curve": "basis", "nodeSpacing": 25, "rankSpacing": 36}, "themeVariables": {"fontFamily": "IBM Plex Mono, monospace", "fontSize": "15px", "primaryColor": "#FFFFFF", "primaryBorderColor": "#0B1220", "primaryTextColor": "#0B1220", "lineColor": "#6B7383", "clusterBkg": "#F4F5F7", "clusterBorder": "#6B7383"}}}%%
%% Lab 07: four ways to answer the two-part Puja question, and who decides the next step in each.
%% Ink: a model decides what happens next. Lime: our code decides. White: an agent that only does its own part.
%% Export: npx -y @mermaid-js/mermaid-cli -i lab07_wirings.mmd -o lab07_wirings.png -b white -s 2
flowchart TB
    subgraph W1["1. one agent, three tools"]
        direction LR
        d1[Desk agent<br/>decides every call] --> t1[find_customer<br/>get_invoices<br/>get_support_rep]
        t1 --> d1
        d1 --> a1[answer]
    end
    subgraph W2["2. our code runs two specialists"]
        direction LR
        c2[our code<br/>asyncio.gather] --> i2[Invoices agent]
        c2 --> r2[Support reps agent]
        i2 --> j2[our code joins<br/>the two answers]
        r2 --> j2
    end
    subgraph W3["3. specialists as tools"]
        direction LR
        m3[Manager agent<br/>decides, gets control back] -->|ask_invoices| i3[Invoices agent]
        i3 -->|result| m3
        m3 -->|ask_support_reps| r3[Support reps agent]
        r3 -->|result| m3
        m3 --> a3[answer]
    end
    subgraph W4["4. handoff"]
        direction LR
        t4[Triage agent<br/>decides once] -->|hand off| i4[Invoices agent<br/>now holds control]
        i4 --> a4[answer from<br/>Invoices only]
    end
    W1 ~~~ W2
    W2 ~~~ W3
    W3 ~~~ W4
    classDef model fill:#0B1220,color:#FFFFFF,stroke:#0B1220
    classDef code fill:#C9F24D,color:#0B1220,stroke:#0B1220
    class d1,m3,t4,i4 model
    class c2,j2 code
