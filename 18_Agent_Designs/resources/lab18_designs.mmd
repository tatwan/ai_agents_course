%% Lab 18: the three designs the lab runs, and what the agent that writes the answer reads in each.
%% Ink: a model decides what happens next. Lime: our code decides. White: data, or an agent that only does its own part.
%% Export: npx -y @mermaid-js/mermaid-cli -i lab18_designs.mmd -o lab18_designs.png -b white -s 2
flowchart TB
    subgraph D1["One agent reads everything"]
        direction LR
        q1[question] --> a1[one agent<br/>calls read_blurb five times]
        a1 -->|five whole blurbs| a1
        a1 --> r1[answer<br/>written after reading five blurbs]
    end
    subgraph D2["Parallel sub-agents, split by our code"]
        direction LR
        c2[our code<br/>one reader per book] --> w2[five reader agents<br/>run at the same time<br/>each reads one blurb]
        w2 -->|five one-line notes| m2[chooser agent<br/>no tools]
        m2 --> r2[answer<br/>written after reading five lines]
    end
    subgraph D3["Hybrid: our code routes on a label"]
        direction LR
        q3[message] --> c3{our code<br/>a command?}
        c3 -->|/next or /pages| h3[our code answers<br/>no model call]
        c3 -->|free text| a3[agent]
        h3 --> r3[answer]
        a3 --> r3
    end
    D1 ~~~ D2
    D2 ~~~ D3
    classDef model fill:#0B1220,color:#FFFFFF,stroke:#0B1220
    classDef code fill:#C9F24D,color:#0B1220,stroke:#0B1220
    class a1,m2,a3 model
    class c2,c3,h3 code
