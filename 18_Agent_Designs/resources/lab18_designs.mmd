%%{init: {"theme": "base", "flowchart": {"curve": "basis", "nodeSpacing": 25, "rankSpacing": 36}, "themeVariables": {"fontFamily": "IBM Plex Mono, monospace", "fontSize": "15px", "primaryColor": "#FFFFFF", "primaryBorderColor": "#0B1220", "primaryTextColor": "#0B1220", "lineColor": "#6B7383", "clusterBkg": "#F4F5F7", "clusterBorder": "#6B7383"}}}%%
%% Lab 18: the five agent designs the lab measures on the desk's requests, and who decides the next step in each.
%% Ink: a model decides what happens next. Lime: our code decides. White: an agent or a lookup that only does its own part.
%% Export: npx -y @mermaid-js/mermaid-cli -i lab18_designs.mmd -o lab18_designs.png -b white -s 2
flowchart TB
    subgraph D1["1. one agent with all the tools"]
        direction LR
        d1[Desk agent<br/>decides every call] --> t1[find_customer<br/>get_invoices<br/>get_support_rep]
        t1 --> d1
        d1 --> a1[answer]
    end
    subgraph D2["2. specialists as tools"]
        direction LR
        m2[Manager agent<br/>decides, gets control back] -->|ask_billing| b2[Billing agent]
        b2 -->|one answer| m2
        m2 -->|ask_support| s2[Support agent]
        s2 -->|one answer| m2
        m2 --> a2[answer]
    end
    subgraph D3["3. handoff"]
        direction LR
        t3[Triage agent<br/>decides once] -->|hand off| b3[Billing agent<br/>now holds control]
        b3 --> a3[answer from<br/>Billing only]
    end
    subgraph D4["4. parallel sub-agents"]
        direction LR
        c4[our code<br/>one worker per customer] --> w4[five worker agents<br/>run at once]
        w4 -->|five one-line answers| m4[Main agent<br/>reads five lines]
        m4 --> a4[answer]
    end
    subgraph D5["5. hybrid of code and agent"]
        direction LR
        r5[our code<br/>routes on the form's label] -->|labelled request| h5[our code<br/>lookups and a template]
        r5 -->|open request| g5[Desk agent<br/>decides every call]
        h5 --> a5[answer]
        g5 --> a5
    end
    D1 ~~~ D2
    D2 ~~~ D3
    D3 ~~~ D4
    D4 ~~~ D5
    classDef model fill:#0B1220,color:#FFFFFF,stroke:#0B1220
    classDef code fill:#C9F24D,color:#0B1220,stroke:#0B1220
    class d1,m2,t3,b3,m4,g5 model
    class c4,r5,h5 code
