%%{init: {"theme": "base", "flowchart": {"curve": "basis", "nodeSpacing": 22, "rankSpacing": 34, "wrappingWidth": 420}, "themeVariables": {"fontFamily": "IBM Plex Mono, monospace", "fontSize": "15px", "primaryColor": "#FFFFFF", "primaryBorderColor": "#0B1220", "primaryTextColor": "#0B1220", "lineColor": "#6B7383", "clusterBkg": "#F4F5F7", "clusterBorder": "#6B7383"}}}%%
%% Lab 22: the damaged-media refund before and after the redesign. Top row: six steps a support rep does by hand today,
%% with the minutes we assume for each. Bottom row: the redesign the notebook works out. Lime = our code; ink = a model
%% (the agent that searches the tickets, and one model call that drafts the reply); white = a person.
%% Export: npx -y @mermaid-js/mermaid-cli -i lab22_process_map.mmd -o lab22_process_map.png -b white -s 2
flowchart TB
    subgraph before["Today: six steps by hand, 18 minutes of a person's time a case"]
      direction LR
      b1["1 Log the email,<br/>copy the order number<br/>2 min"] --> b2["2 Check the order date<br/>and the photo<br/>3 min"]
      b2 --> b3["3 Find the earlier<br/>damage report<br/>4 min"]
      b3 --> b4["4 Apply the policy:<br/>replace or refund<br/>2 min"]
      b4 --> b5["5 Write the reply<br/>4 min"]
      b5 --> b6["6 Issue the refund<br/>3 min"]
    end
    subgraph after["Redesigned: 2 minutes of handling and 2 of review a case"]
      direction LR
      a1["Log the email and<br/>check the order date<br/>our code · act with audit"] --> a2["Find the earlier report<br/>an agent searches the tickets · suggest"]
      a2 --> a3["Apply the policy<br/>our code · draft"]
      a3 --> a4["Draft the reply<br/>one model call · draft"]
      a4 --> a5["Review the photo, the<br/>earlier ticket, the decision<br/>and the reply · a person, 2 min"]
      a5 --> a6["Approve the refund<br/>a person, 2 min · draft"]
    end
    before ~~~ after
    classDef model fill:#0B1220,color:#FFFFFF,stroke:#0B1220
    classDef code fill:#C9F24D,color:#0B1220,stroke:#0B1220
    class a2,a4 model
    class a1,a3 code
