%% Bonus B9: the two shapes the lab compares. Top: the chain prompt | llm | parser, whose three steps our code fixed;
%% each edge is labelled with the object one step hands the next. Bottom: lab 08's agent, where the route after the
%% model depends on what the model wrote, and the tools node loops back to the model.
%% Ink = the model's work; lime = our code (template, parser, lookups, route).
%% Export: npx -y @mermaid-js/mermaid-cli -i labB9_chain_and_agent.mmd -o labB9_chain_and_agent.png -b white -s 2
flowchart TB
    subgraph chain["Fixed chain (this lab): our code set the steps"]
        direction LR
        input([dict<br/>policy, ticket]) -->|dict| template[ChatPromptTemplate<br/>fills the gaps]
        template -->|ChatPromptValue| model1[ChatOpenAI<br/>one model call]
        model1 -->|AIMessage| parser[StrOutputParser<br/>keeps the text]
        parser -->|str| output([draft reply])
    end
    subgraph agent["Agent (lab 08): the model picks the next step"]
        direction LR
        messages([messages]) --> model2[model node<br/>one model call<br/>per turn]
        model2 --> route{tool calls<br/>in the reply?}
        route -->|yes| tools[tools node<br/>runs our lookups]
        tools -->|back edge| model2
        route -->|no| answer([answer])
    end
    chain ~~~ agent
    classDef model fill:#0B1220,color:#FFFFFF,stroke:#0B1220
    classDef code fill:#C9F24D,color:#0B1220,stroke:#0B1220
    class model1,model2 model
    class template,parser,route,tools code
