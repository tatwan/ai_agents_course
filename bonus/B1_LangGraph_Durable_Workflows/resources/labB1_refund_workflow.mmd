%%{init: {"theme": "base", "flowchart": {"curve": "basis", "nodeSpacing": 25, "rankSpacing": 35}, "themeVariables": {"fontFamily": "IBM Plex Mono, monospace", "fontSize": "15px", "primaryColor": "#FFFFFF", "primaryBorderColor": "#0B1220", "primaryTextColor": "#0B1220", "lineColor": "#6B7383", "clusterBkg": "#F4F5F7", "clusterBorder": "#6B7383"}}}%%
%% B1: independent checks merge before routing; a review waits in SQLite and resumes in a new process.
%% Lime: our code. White: waiting state, storage or the person providing a decision. No model nodes.
%% Export: npx -y @mermaid-js/mermaid-cli -i labB1_refund_workflow.mmd -o labB1_refund_workflow.png -b white -s 2
flowchart TB
    S([START]) --> N[normalize]
    N --> P[policy_check]
    N --> A[amount_check]
    P --> D[decide<br/>wait for both checks]
    A --> D
    D -->|no signals| U[auto_approve]
    D -->|signals| H[human_review<br/>counter then interrupt]
    H -.->|waiting checkpoint| Q[(SQLite)]
    Q -.->|new process<br/>same thread| R[reviewer: approve or reject]
    R -.->|Command resume| H
    H -->|review decision| F[finalize]
    U --> F
    F --> E([END])
    classDef code fill:#C9F24D,color:#0B1220,stroke:#0B1220
    classDef model fill:#0B1220,color:#FFFFFF,stroke:#0B1220
    class N,P,A,D,U,H,F code
