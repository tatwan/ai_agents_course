%% Export: npx -y @mermaid-js/mermaid-cli -i labB6_same_vectors_two_stores.mmd -o labB6_same_vectors_two_stores.png -b white -s 2
flowchart LR
    files[the shop's 36 files] --> embedD[embed once<br/>36 vectors]
    question[the rep's question] --> embedQ[embed the question<br/>one vector]
    embedD --> chroma[(Chroma collection<br/>in this notebook)]
    embedD --> pinecone[(Pinecone index<br/>in your account)]
    embedQ --> chroma
    embedQ --> pinecone
    chroma --> compare[compare<br/>the two rankings]
    pinecone --> compare
    classDef model fill:#0B1220,color:#FFFFFF,stroke:#0B1220
    classDef code fill:#C9F24D,color:#0B1220,stroke:#0B1220
    class embedD,embedQ model
