%% Two task owners; the first task carries identity and evidence to the second.
%% Export: npx -y @mermaid-js/mermaid-cli -i labB4_crew.mmd -o labB4_crew.png -b white -s 2
flowchart LR
    request[customer name<br/>refund requested?] --> process[Python chooses<br/>sequential tasks]
    process --> billing[Invoice specialist]
    billing --> find[find_customer<br/>get_invoices]
    find --> billing
    billing --> evidence[InvoiceEvidence<br/>name, ID, totals, source]
    evidence -->|task context| support[Support specialist]
    support --> rep[get_support_rep]
    rep --> support
    support --> answer[DeskAnswer<br/>facts, recommendation, evidence]
    answer --> guard[Python checks<br/>recommendation]
    classDef model fill:#0B1220,color:#FFFFFF,stroke:#0B1220
    classDef code fill:#C9F24D,color:#0B1220,stroke:#0B1220
    class billing,support model
    class process,find,rep,guard code
