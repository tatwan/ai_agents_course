%% The agent chooses tools; the refund graph pauses for a human before queueing.
%% Export: npx -y @mermaid-js/mermaid-cli -i labB6_agent_and_workflow.mmd -o labB6_agent_and_workflow.png -b white -s 2
flowchart TB
    subgraph A[Desk agent]
        direction LR
        q[Customer question] --> model[Agent with model client]
        model --> tools[Three read-only Chinook tools]
        tools --> model
        model --> answer[Answer and usage]
    end
    subgraph W[Refund workflow without a model]
        direction TB
        claim[Invented claim] --> check[CheckRequest]
        check --> review[HumanReview]
        review --> disk[File checkpoint<br/>pending review]
        disk --> person[Person decides<br/>in new process]
        person -->|approve| queue[QueueRequest<br/>unique business ID]
        person -->|reject| stop[Rejected output]
        queue --> record[Local queue row]
    end
    A ~~~ W
    classDef model fill:#0B1220,color:#FFFFFF,stroke:#0B1220
    classDef code fill:#C9F24D,color:#0B1220,stroke:#0B1220
    class model model
    class tools,check,review,disk,person,queue code
