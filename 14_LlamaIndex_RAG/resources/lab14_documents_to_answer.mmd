%% Lab 14: the LlamaIndex path from a folder of files to an agent's answer. SimpleDirectoryReader turns the files into
%% Documents, the index embeds them (one vector per node) and a retriever returns the nearest nodes with their scores.
%% Two ways to hand that search to an agent: a query engine tool (a second model call writes a sentence from the nodes:
%% the step that hides the files, lit) or a retriever tool (the nodes' text goes to the agent). Ink: a model writes text.
%% Export: npx -y @mermaid-js/mermaid-cli -i lab14_documents_to_answer.mmd -o lab14_documents_to_answer.png -b white -s 2
flowchart LR
    files[a folder<br/>of files] --> docs[Documents<br/>SimpleDirectoryReader]
    docs --> index[VectorStoreIndex<br/>one vector per node]
    index --> ret[retriever<br/>top k nodes<br/>with scores]
    ret --> qe[query engine<br/>a model writes<br/>a sentence]
    qe --> qet[QueryEngineTool<br/>returns the sentence]
    ret --> rt[RetrieverTool<br/>returns the text<br/>of the nodes]
    qet --> agent[FunctionAgent<br/>model writes queries<br/>and the answer]
    rt --> agent
    classDef model fill:#0B1220,color:#FFFFFF,stroke:#0B1220
    classDef look fill:#C9F24D,color:#0B1220,stroke:#0B1220
    class agent model
    class qe look
