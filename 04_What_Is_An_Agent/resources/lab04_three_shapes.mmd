%%{init: {"theme": "base", "flowchart": {"curve": "basis", "nodeSpacing": 30, "rankSpacing": 40}, "themeVariables": {"fontFamily": "IBM Plex Mono, monospace", "fontSize": "15px", "primaryColor": "#FFFFFF", "primaryBorderColor": "#0B1220", "primaryTextColor": "#0B1220", "lineColor": "#6B7383", "clusterBkg": "#F4F5F7", "clusterBorder": "#6B7383"}}}%%
%% Lab 04: one question, three shapes, told apart by who decides the next step. The model's steps in ink, our code's in lime.
%% Export: npx -y @mermaid-js/mermaid-cli -i lab04_three_shapes.mmd -o lab04_three_shapes.png -b white -s 2
flowchart LR
    subgraph CHATBOT["chatbot: nobody decides, one reply"]
        direction TB
        c0[question] --> c1[model<br/>writes a reply] --> c2[reply]
    end
    subgraph WORKFLOW["workflow: we decide, in advance"]
        direction TB
        w0[question] --> w1[our code<br/>step 1] --> w2[our code<br/>step 2] --> w3[our code<br/>fills in a<br/>fixed reply]
    end
    subgraph AGENT["agent: the model decides, as it runs"]
        direction TB
        a0[question] --> a1[model<br/>asks for a tool<br/>or answers]
        a1 -->|tool call| a2[our code<br/>runs the tool]
        a2 -->|result| a1
        a1 -->|answer| a3[reply]
        a1 -->|turn cap| a4["no answer: None"]
    end
    CHATBOT ~~~ WORKFLOW ~~~ AGENT
    classDef model fill:#0B1220,color:#FFFFFF,stroke:#0B1220
    classDef code fill:#C9F24D,color:#0B1220,stroke:#0B1220
    class c1,a1 model
    class w1,w2,w3,a2 code
